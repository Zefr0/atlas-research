# Copy this file to `.env` and fill in your keys. `.env` is read at startup by src/config.py.

# REQUIRED — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — override the model (default: openai/gpt-oss-120b).
# List what your account can use: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Optional — automatic failover model when the primary hits its rate limit.
# Groq quotas are per model, so this is a second daily token budget.
# Leave empty to disable failover. Default: openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional but recommended — free tier at https://app.tavily.com
# If missing, the app automatically falls back to DuckDuckGo (no key needed).
TAVILY_API_KEY=

# Optional tuning knobs
MAX_REVISIONS=2            # How many times the Fact-Checker may send the report back
MAX_SEARCH_RESULTS=5       # Results fetched per sub-question
